{
  "name": "skillbridge-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run typecheck && npm run build:frontend && npm run package:java",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:java": "mvn -f backend/java/pom.xml test",
    "compile:java": "mvn -f backend/java/pom.xml compile",
    "package:java": "mvn -f backend/java/pom.xml clean package"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
